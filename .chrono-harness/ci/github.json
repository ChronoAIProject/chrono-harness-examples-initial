{
  "schema": "chrono-github-ci/v4",
  "workflow_path": ".github/workflows/chrono-ci.yml",
  "name": "chrono-harness",
  "runs_on": "macos-14",
  "push_branches": [
    "dev"
  ],
  "pull_request_branches": [
    "dev",
    "integration/**"
  ],
  "branch_creation_base_ref": "refs/heads/dev",
  "checkout_action": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
  "upload_artifact_action": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
  "timeout_minutes": 45,
  "bootstrap": [
    "/bin/sh",
    ".chrono-harness/install.sh",
    "--host-root",
    "."
  ],
  "runner": ".chrono-harness/bin/chrono-harness",
  "generator": ".chrono-harness/bin/chrono-ci",
  "check_config": ".chrono-harness/ci/check.json",
  "context_path": ".chrono-harness/state/context.json",
  "artifact_directory": ".chrono-harness/state/",
  "initial_inventory": {
    "path": ".chrono-harness/ci/initial.json",
    "profile": {
      "schema": "chrono-initial-check/v1",
      "host_config": ".chrono-harness/config.json",
      "timeout_seconds": 120,
      "stdout_limit_bytes": 1048576,
      "judges": [
        {
          "id": "initial-registration",
          "executable": ".chrono-harness/bin/chrono-judge-registration",
          "sha256": "0748bb868f899ead286f036c388863ffc8d400f84300c94f2a498e6dd138f182",
          "argv": [
            "--protocol",
            "chrono-initial-judge/v1"
          ],
          "selector": "every-initial",
          "after": [],
          "modes": [
            "inventory"
          ],
          "version": "0.1.0"
        }
      ]
    }
  },
  "facts_config": ".chrono-harness/config.json",
  "include_hidden_files": true
}
